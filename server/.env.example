# WristGame payment backend — environment variables
# ---------------------------------------------------------------------------
# Copy this file to ".env" (same folder) and fill it in ON THE SERVER ONLY.
# ".env" is listed in .gitignore: never commit it, never paste these values
# into anything under src/, and never prefix them with VITE_ (Vite copies
# VITE_ variables into the public website).
#
# Every value below is intentionally empty. Nothing is connected until you
# have a merchant account and add its credentials here.

# Port this backend listens on.
PORT=8787

# The website address allowed to call this backend, e.g. https://www.your-domain.com
FRONTEND_ORIGIN=

# The public address of this backend, e.g. https://api.your-domain.com
# (the payment provider sends its notifications to <PUBLIC_API_URL>/api/payments/webhook)
PUBLIC_API_URL=

# Name of the adapter file in server/providers/ (without .mjs) for your payment provider.
PAYMENT_PROVIDER=

# Credentials issued by the payment provider with your merchant account. SECRET.
PAYMENT_MERCHANT_ID=
PAYMENT_MERCHANT_SECRET=

# Secret used to verify that notifications really come from the provider. SECRET.
PAYMENT_WEBHOOK_SECRET=

# true = the provider's test/sandbox environment, false = real money.
PAYMENT_SANDBOX=true
